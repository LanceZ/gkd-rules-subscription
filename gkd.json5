{
  "id": 20261029,
  "name": "Lance 的 GKD 订阅",
  "version": 19,
  "author": "Lance",
  "updateUrl": "https://raw.githubusercontent.com/LanceZ/gkd-rules-subscription/main/gkd.json5",
  "checkUpdateUrl": "https://raw.githubusercontent.com/LanceZ/gkd-rules-subscription/main/gkd.version.json5",
  "categories": [],
  "globalGroups": [
    {
      "key": 0,
      "name": "开屏广告",
      "desc": "点击跳过应用启动时的开屏广告",
      "fastQuery": true,
      "matchRoot": true,
      "matchTime": 9000,
      "actionMaximum": 2,
      "resetMatch": "app",
      "actionMaximumKey": 0,
      "priorityTime": 9000,
      "order": -10,
      "forcedTime": 9000,
      "disableIfAppGroupMatch": "开屏广告",
      "rules": [
        {
          "key": 0,
          "name": "快速查询",
          "excludeSnapshotUrls": [
            "https://i.gkd.li/i/17108010",
            "https://i.gkd.li/i/18265000",
            "https://i.gkd.li/i/19580951",
            "https://i.gkd.li/i/19952277",
            "https://i.gkd.li/i/20946730",
            "https://i.gkd.li/i/20949002",
            "https://i.gkd.li/i/22634992"
          ],
          "excludeMatches": [
            "[text=\"Submit\" || text=\"书签\" || text=\"NEXT\" || text=\"覆盖\" || text*=\"阅读并同意\" || ((text*=\"搜索\" || text=\"历史记录\" || text$=\"在搜\") && text.length>3 && text.length<7) || ((text$=\"设置\" || text*=\"跳过片\" || (text^=\"选择\" && (text*=\"偏好\" || text*=\"兴趣\" || text*=\"喜好\" || text*=\"行业\"))) && text.length<10)][visibleToUser=true]",
            "[id~=\"(?is).*search.*\"] < * > [(id~=\"(?is).*clear.*\")||(id~=\"(?is).*close.*\")||(id~=\"(?is).*back.*\")||(text~=\"(?is).*取消.*\")][height>0&&width>0][top>0&&left>0]",
            "[name!$=\".EditText\"] < * > [(id~=\"(?is).*clear.*\")||(id~=\"(?is).*close.*\")||(id~=\"(?is).*back.*\")||(text~=\"(?is).*取消.*\")][height>0&&width>0][top>0&&left>0]"
          ],
          "anyMatches": [
            "[text^=\"跳\"][name!$=\".CheckBox\"][name!$=\".EditText\"][name!$=\".ProgressBar\"][childCount=0][visibleToUser=true][height>0&&width>0&&width<500&&height<300][top>0&&left>0][text.length<10][((text*=\"跳过\"||text*=\"跳 过\"||text*=\"跳過\"||text*=\"跳 過\"||text~=\"(?is).*skip.*\")&&text!*=\"视频\"&&text!*=\"片头\"&&text!*=\"片尾\")][!(text~=\"([01]?[0-9]|2[0-3])[:：][0-5][0-9]\")][!(desc~=\"([01]?[0-9]|2[0-3])[:：][0-5][0-9]\")]",
            "[text*=\"跳过\"][name!$=\".CheckBox\"][name!$=\".EditText\"][name!$=\".ProgressBar\"][childCount=0][visibleToUser=true][height>0&&width>0&&width<500&&height<300][top>0&&left>0][text.length<10][((text*=\"跳过\"||text*=\"跳 过\"||text*=\"跳過\"||text*=\"跳 過\"||text~=\"(?is).*skip.*\")&&text!*=\"视频\"&&text!*=\"片头\"&&text!*=\"片尾\")][!(text~=\"([01]?[0-9]|2[0-3])[:：][0-5][0-9]\")][!(desc~=\"([01]?[0-9]|2[0-3])[:：][0-5][0-9]\")]",
            "[text*=\"跳 过\"][name!$=\".CheckBox\"][name!$=\".EditText\"][name!$=\".ProgressBar\"][childCount=0][visibleToUser=true][height>0&&width>0&&width<500&&height<300][top>0&&left>0][text.length<10][((text*=\"跳过\"||text*=\"跳 过\"||text*=\"跳過\"||text*=\"跳 過\"||text~=\"(?is).*skip.*\")&&text!*=\"视频\"&&text!*=\"片头\"&&text!*=\"片尾\")][!(text~=\"([01]?[0-9]|2[0-3])[:：][0-5][0-9]\")][!(desc~=\"([01]?[0-9]|2[0-3])[:：][0-5][0-9]\")]",
            "[text*=\"跳過\"][name!$=\".CheckBox\"][name!$=\".EditText\"][name!$=\".ProgressBar\"][childCount=0][visibleToUser=true][height>0&&width>0&&width<500&&height<300][top>0&&left>0][text.length<10][((text*=\"跳过\"||text*=\"跳 过\"||text*=\"跳過\"||text*=\"跳 過\"||text~=\"(?is).*skip.*\")&&text!*=\"视频\"&&text!*=\"片头\"&&text!*=\"片尾\")][!(text~=\"([01]?[0-9]|2[0-3])[:：][0-5][0-9]\")][!(desc~=\"([01]?[0-9]|2[0-3])[:：][0-5][0-9]\")]",
            "[text*=\"跳 過\"][name!$=\".CheckBox\"][name!$=\".EditText\"][name!$=\".ProgressBar\"][childCount=0][visibleToUser=true][height>0&&width>0&&width<500&&height<300][top>0&&left>0][text.length<10][((text*=\"跳过\"||text*=\"跳 过\"||text*=\"跳過\"||text*=\"跳 過\"||text~=\"(?is).*skip.*\")&&text!*=\"视频\"&&text!*=\"片头\"&&text!*=\"片尾\")][!(text~=\"([01]?[0-9]|2[0-3])[:：][0-5][0-9]\")][!(desc~=\"([01]?[0-9]|2[0-3])[:：][0-5][0-9]\")]",
            "[text*=\"skip\"][name!$=\".CheckBox\"][name!$=\".EditText\"][name!$=\".ProgressBar\"][childCount=0][visibleToUser=true][height>0&&width>0&&width<500&&height<300][top>0&&left>0][text.length<10][((text*=\"跳过\"||text*=\"跳 过\"||text*=\"跳過\"||text*=\"跳 過\"||text~=\"(?is).*skip.*\")&&text!*=\"视频\"&&text!*=\"片头\"&&text!*=\"片尾\")][!(text~=\"([01]?[0-9]|2[0-3])[:：][0-5][0-9]\")][!(desc~=\"([01]?[0-9]|2[0-3])[:：][0-5][0-9]\")]",
            "[text*=\"Skip\"][name!$=\".CheckBox\"][name!$=\".EditText\"][name!$=\".ProgressBar\"][childCount=0][visibleToUser=true][height>0&&width>0&&width<500&&height<300][top>0&&left>0][text.length<10][((text*=\"跳过\"||text*=\"跳 过\"||text*=\"跳過\"||text*=\"跳 過\"||text~=\"(?is).*skip.*\")&&text!*=\"视频\"&&text!*=\"片头\"&&text!*=\"片尾\")][!(text~=\"([01]?[0-9]|2[0-3])[:：][0-5][0-9]\")][!(desc~=\"([01]?[0-9]|2[0-3])[:：][0-5][0-9]\")]",
            "[text*=\"SKIP\"][name!$=\".CheckBox\"][name!$=\".EditText\"][name!$=\".ProgressBar\"][childCount=0][visibleToUser=true][height>0&&width>0&&width<500&&height<300][top>0&&left>0][text.length<10][((text*=\"跳过\"||text*=\"跳 过\"||text*=\"跳過\"||text*=\"跳 過\"||text~=\"(?is).*skip.*\")&&text!*=\"视频\"&&text!*=\"片头\"&&text!*=\"片尾\")][!(text~=\"([01]?[0-9]|2[0-3])[:：][0-5][0-9]\")][!(desc~=\"([01]?[0-9]|2[0-3])[:：][0-5][0-9]\")]",
            "[vid=\"tt_splash_skip_btn\"||vid=\"btn_skip\"||vid=\"skip_btn\"||vid=\"skip_button\"||vid=\"skipButton\"||vid=\"ad_skip\"||vid=\"ad_skip_btn\"||vid=\"splash_skip\"||vid=\"splash_skip_btn\"||vid=\"tme_ad_skip_button\"||vid=\"skip_ad_button\"||vid=\"splash_ad_close\"||vid=\"ksad_splash_skip_view\"||vid=\"ksad_skip_view\"][name!$=\".CheckBox\"][name!$=\".EditText\"][name!$=\".ProgressBar\"][childCount=0][visibleToUser=true][height>0&&width>0&&width<500&&height<300][top>0&&left>0][vid~=\"(?is).*skip.*\"][vid!~=\"(?is).*video.*\"][vid!~=\"(?is).*head.*\"][vid!~=\"(?is).*tail.*\"][!(text=\"帮助\")][!(text=\"取消\")][!(text*=\"退出\")][!(text~=\"([01]?[0-9]|2[0-3])[:：][0-5][0-9]\")][!(desc~=\"([01]?[0-9]|2[0-3])[:：][0-5][0-9]\")]",
            "[vid=\"count_down\"||vid=\"count_down_view\"||vid=\"countDown\"||vid=\"countDownView\"||vid=\"gdt_count_down_view\"||vid=\"GdtCountDownView\"||vid=\"ui_count_down\"][name!$=\".CheckBox\"][name!$=\".EditText\"][name!$=\".ProgressBar\"][childCount=0][visibleToUser=true][height>0&&width>0&&width<500&&height<300][top>0&&left>0][(vid~=\"(?is).*count.*\"&&vid~=\"(?is).*down.*\"&&!(vid~=\"(?is).*load.*\")&&!(vid~=\"(?is).*hour.*\")&&!(vid~=\"(?is).*minute.*\")&&!(vid~=\"(?is).*timing.*\")&&!(vid~=\"(?is).*add.*\")&&!(vid~=\"(?is).*ead.*\"))][!(text~=\"([01]?[0-9]|2[0-3])[:：][0-5][0-9]\")][!(desc~=\"([01]?[0-9]|2[0-3])[:：][0-5][0-9]\")]"
          ]
        },
        {
          "key": 1,
          "name": "字节SDK",
          "snapshotUrls": [
            "https://i.gkd.li/i/19685971",
            "https://i.gkd.li/i/19701216",
            "https://i.gkd.li/i/20262130"
          ],
          "action": "clickCenter",
          "excludeMatches": [
            "([text*=\"搜索\" || text^=\"猜你想\" || text^=\"猜你喜欢\" || text=\"历史记录\" || text$=\"在搜\"][text.length>3 && text.length<7][visibleToUser=true][height>0&&width>0][top>0&&left>0]) || ([text=\"设置\" || text=\"退款详情\" || text=\"Submit\"][visibleToUser=true][height>0&&width>0][top>0&&left>0])",
            "[id~=\"(?is).*search.*\"] < * > [(id~=\"(?is).*clear.*\")||(id~=\"(?is).*close.*\")||(id~=\"(?is).*back.*\")||(text~=\"(?is).*取消.*\")][height>0&&width>0][top>0&&left>0]",
            "[name!$=\".EditText\"] < * > [(id~=\"(?is).*clear.*\")||(id~=\"(?is).*close.*\")||(id~=\"(?is).*back.*\")||(text~=\"(?is).*取消.*\")][height>0&&width>0][top>0&&left>0]"
          ],
          "anyMatches": [
            "@View[text=null][clickable=true][childCount=0][visibleToUser=true][width<200&&height<200] +(1,2) TextView[index=parent.childCount.minus(1)][childCount=0] <n FrameLayout[childCount>2][text=null][desc=null] >(n+6) [text*=\"第三方应用\" || text*=\"扭动手机\" || text*=\"点击或上滑\" || text*=\"省钱好物\" || text*=\"扭一扭\"][visibleToUser=true]",
            "FrameLayout > FrameLayout[childCount>2][text=null][desc=null] > @View[text=null][clickable=true][childCount=0][visibleToUser=true][width<200&&height<200] +(1,2) TextView[index=parent.childCount.minus(1)][childCount=0][visibleToUser=true]"
          ]
        },
        {
          "key": 2,
          "name": "互动广告SDK",
          "snapshotUrls": [
            "https://i.gkd.li/i/21499354",
            "https://i.gkd.li/i/21617612"
          ],
          "matches": [
            "[text=\"广告\"]",
            "@View[clickable=true][childCount=0] - [text=\"互动广告\"][visibleToUser=true]"
          ],
          "excludeMatches": [
            "([text*=\"搜索\" || text^=\"猜你想\" || text^=\"猜你喜欢\" || text=\"历史记录\" || text$=\"在搜\"][text.length>3 && text.length<7][visibleToUser=true][height>0&&width>0][top>0&&left>0]) || ([text=\"设置\" || text=\"退款详情\" || text=\"Submit\"][visibleToUser=true][height>0&&width>0][top>0&&left>0])",
            "[id~=\"(?is).*search.*\"] < * > [(id~=\"(?is).*clear.*\")||(id~=\"(?is).*close.*\")||(id~=\"(?is).*back.*\")||(text~=\"(?is).*取消.*\")][height>0&&width>0][top>0&&left>0]",
            "[name!$=\".EditText\"] < * > [(id~=\"(?is).*clear.*\")||(id~=\"(?is).*close.*\")||(id~=\"(?is).*back.*\")||(text~=\"(?is).*取消.*\")][height>0&&width>0][top>0&&left>0]"
          ]
        },
        {
          "key": 3,
          "name": "兜底查询",
          "matchDelay": 1000,
          "excludeSnapshotUrls": [
            "https://i.gkd.li/i/17108010",
            "https://i.gkd.li/i/18265000",
            "https://i.gkd.li/i/19580951",
            "https://i.gkd.li/i/19952277",
            "https://i.gkd.li/i/20946730",
            "https://i.gkd.li/i/20949002",
            "https://i.gkd.li/i/22634992"
          ],
          "matches": [
            "[name!$=\".CheckBox\"][name!$=\".EditText\"][name!$=\".ProgressBar\"][childCount=0][visibleToUser=true][height>0&&width>0&&width<500&&height<300][top>0&&left>0][((text.length<10&&(text*=\"跳过\"||text*=\"跳 过\"||text*=\"跳過\"||text*=\"跳 過\"||text~=\"(?is).*skip.*\")&&text!*=\"视频\"&&text!*=\"片头\"&&text!*=\"片尾\")||id~=\"(?is).*tt_splash_skip_btn\"||(vid~=\"(?is).*skip.*\"&&vid!~=\"(?is).*video.*\"&&vid!~=\"(?is).*head.*\"&&vid!~=\"(?is).*tail.*\"&&!(text=\"帮助\")&&!(text=\"取消\")&&!(text*=\"退出\"))||(vid~=\"(?is).*count.*\"&&vid~=\"(?is).*down.*\"&&!(vid~=\"(?is).*load.*\")&&!(vid~=\"(?is).*hour.*\")&&!(vid~=\"(?is).*minute.*\")&&!(vid~=\"(?is).*timing.*\")&&!(vid~=\"(?is).*add.*\")&&!(vid~=\"(?is).*ead.*\"))||(desc.length<10&&(desc*=\"跳过\"||desc*=\"跳過\"||desc~=\"(?is).*skip.*\")))][!(text~=\"([01]?[0-9]|2[0-3])[:：][0-5][0-9]\")][!(desc~=\"([01]?[0-9]|2[0-3])[:：][0-5][0-9]\")]"
          ],
          "excludeMatches": [
            "[text=\"Submit\" || text=\"书签\" || text=\"NEXT\" || text=\"覆盖\" || text*=\"阅读并同意\" || ((text*=\"搜索\" || text=\"历史记录\" || text$=\"在搜\") && text.length>3 && text.length<7) || ((text$=\"设置\" || text*=\"跳过片\" || (text^=\"选择\" && (text*=\"偏好\" || text*=\"兴趣\" || text*=\"喜好\" || text*=\"行业\"))) && text.length<10)][visibleToUser=true]",
            "[id~=\"(?is).*search.*\"] < * > [(id~=\"(?is).*clear.*\")||(id~=\"(?is).*close.*\")||(id~=\"(?is).*back.*\")||(text~=\"(?is).*取消.*\")][height>0&&width>0][top>0&&left>0]",
            "[name!$=\".EditText\"] < * > [(id~=\"(?is).*clear.*\")||(id~=\"(?is).*close.*\")||(id~=\"(?is).*back.*\")||(text~=\"(?is).*取消.*\")][height>0&&width>0][top>0&&left>0]"
          ]
        }
      ],
      "apps": [
        {
          "id": "com.tencent.mm",
          "enable": false
        },
        {
          "id": "li.songe.gkd",
          "enable": false
        },
        {
          "id": "mark.via",
          "enable": false
        },
        {
          "id": "mark.via.gp",
          "enable": false
        },
        {
          "id": "com.mmbox.xbrowser",
          "enable": false
        },
        {
          "id": "com.mmbox.xbrowser.pro",
          "enable": false
        },
        {
          "id": "com.mycompany.app.soulbrowser",
          "enable": false
        }
      ]
    }
  ],
  "apps": [
    {
      "id": "com.baidu.tieba",
      "name": "百度贴吧",
      "groups": [
        {
          "key": 0,
          "name": "首页-推荐-黑名单贴吧",
          "activityIds": [
            "com.baidu.tieba.tblauncher.MainTabActivity"
          ],
          "rules": [
            {
              "key": 0,
              "action": "click",
              "matches": [
                "@ImageView <2 LinearLayout <4 RelativeLayout > LinearLayout > LinearLayout > [text*=\"鸣潮\"]"
              ],
              "fastQuery": true
            },
            {
              "key": 50,
              "name": "点击不喜欢",
              "preKeys": [
                0
              ],
              "matches": [
                "@CheckBox[text=\"不喜欢\"]"
              ],
              "fastQuery": true
            }
          ],
          "enable": true
        }
      ]
    },
    {
      "id": "com.dragon.read",
      "name": "番茄免费小说",
      "groups": [
        {
          "key": 0,
          "name": "局部广告-阅读-卡片广告",
          "desc": "点击X",
          "enable": true,
          "activityIds": [
            ".reader.ui.ReaderActivity"
          ],
          "rules": [
            {
              "key": 0,
              "name": "底部卡片广告-text 匹配",
              "anyMatches": [
                "@View[index=0] +5 View > TextView[text=\"免费阅读\"  || text=\"查看详情\" || text=\"立即阅读\" ||text=\"立即下载\"||text=\"立即参加\" ||text=\"点击阅读\"||text=\"微信试玩\"||text=\"立即抢购\"]",
                "@ImageView < ViewGroup <3 ViewGroup[left=0][height=360][index=0][childCount>1]"
              ]
            },
            {
              "key": 1,
              "name": "底部卡片广告-view 匹配",
              "anyMatches": [
                "@ImageView < ViewGroup <3 ViewGroup[left=0][height=360][index=0][childCount>1]"
              ]
            },
            {
              "key": 50,
              "name": "点击关闭此广告",
              "preKeys": [
                1
              ],
              "matches": [
                "[text=\"关闭此广告\"]"
              ],
              "actionDelay": 100
            }
          ]
        },
        {
          "key": 1,
          "name": "局部广告-阅读-整页广告",
          "desc": "反馈、关闭或滑走",
          "enable": true,
          "activityIds": [
            ".reader.ui.ReaderActivity"
          ],
          "rules": [
            {
              "key": 0,
              "name": "有关闭按钮-反馈",
              "position": {
                "left": "width * 0.8",
                "top": "height * 0.5"
              },
              "matches": [
                "@ViewGroup[index=0][childCount=0][width>1000] <<n ViewGroup -n ViewGroup > ViewGroup > FrameLayout > FrameLayout > FrameLayout > FrameLayout > [vid=\"ttlive_player_render_view\"][visibleToUser=true]"
              ],
              "activityIds": [
                ".reader.ui.ReaderActivity"
              ]
            },
            {
              "key": 1,
              "name": "无关闭按钮-反馈",
              "matches": [
                "@ViewGroup[index=0][childCount=0][width<200] <<n ViewGroup -n ViewGroup > ViewGroup > FrameLayout > FrameLayout > FrameLayout > FrameLayout > [vid=\"ttlive_player_render_view\"][visibleToUser=true]"
              ],
              "activityIds": [
                ".reader.ui.ReaderActivity"
              ]
            },
            {
              "key": 2,
              "name": "图片广告-点击右下方",
              "position": {
                "x": "screenWidth*0.95",
                "y": "screenHeight*0.95"
              },
              "matches": [
                "[text=\"免费看剧\" || text =\"收藏\" || text=\"点击关闭广告并退出小说\"][visibleToUser=true]"
              ],
              "excludeMatches": [
                "[vid=\"ttlive_player_render_view\"]"
              ],
              "actionDelay": 100,
              "activityIds": [
                ".reader.ui.ReaderActivity"
              ]
            },
            {
              "key": 3,
              "name": "直播广告-点击右下方",
              "position": {
                "x": "screenWidth*0.95",
                "y": "screenHeight*0.95"
              },
              "matches": [
                "@ImageView[vid=null][visibleToUser=true][width>1000][height>1000]"
              ],
              "excludeMatches": [
                "@ViewGroup[index=0][childCount=0][width>1000] <<n ViewGroup -n ViewGroup > ViewGroup > FrameLayout > FrameLayout > FrameLayout > FrameLayout > [vid=\"ttlive_player_render_view\"][visibleToUser=true]",
                "@ViewGroup[index=0][childCount=0][width<200] <<n ViewGroup -n ViewGroup > ViewGroup > FrameLayout > FrameLayout > FrameLayout > FrameLayout > [vid=\"ttlive_player_render_view\"][visibleToUser=true]"
              ],
              "actionDelay": 100,
              "activityIds": [
                ".reader.ui.ReaderActivity"
              ]
            },
            {
              "key": 50,
              "name": "点击不感兴趣",
              "preKeys": [
                0,
                1
              ],
              "matches": [
                "[text=\"不感兴趣\"]"
              ],
              "actionDelay": 100
            }
          ]
        },
        {
          "key": 2,
          "name": "弹出对话框",
          "desc": "点击取消",
          "enable": true,
          "rules": [
            {
              "key": 0,
              "name": "点评此书-点击取消",
              "matches": [
                "@[text=\"取消\"] -n [text=\"点评此书\"]"
              ]
            },
            {
              "key": 1,
              "name": "添加到主屏幕-点击取消",
              "matches": [
                "@[text=\"取消\"] < LinearLayout -n [text=\"添加到主屏幕\"]"
              ]
            },
            {
              "key": 2,
              "name": "开启推送提醒-点击取消",
              "matches": [
                "@[text=\"取消\"] < LinearLayout -n [text=\"开启推送提醒\"]"
              ]
            }
          ]
        },
        {
          "key": 3,
          "name": "局部广告-阅读-内文视频广告",
          "desc": "点击本书不再展示",
          "enable": true,
          "activityIds": [
            ".reader.ui.ReaderActivity"
          ],
          "rules": [
            {
              "key": 0,
              "name": "内文视频广告匹配",
              "anyMatches": [
                "@ImageView[visibleToUser=true] +2 ViewGroup > TextView[text=\"播放全集\"]"
              ]
            },
            {
              "key": 50,
              "name": "点击本书不再展示",
              "preKeys": [
                0
              ],
              "matches": [
                "TextView[text=\"本书不再展示\"]"
              ],
              "actionDelay": 100
            }
          ]
        }
      ]
    },
    {
      "id": "com.kmxs.reader",
      "name": "七猫免费小说",
      "groups": [
        {
          "key": 0,
          "name": "底部广告",
          "enable": true,
          "fastQuery": true,
